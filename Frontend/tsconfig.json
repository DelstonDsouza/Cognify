{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* FIX: "jsx-runtime" error — use react-jsx */
    "jsx": "react-jsx",

    /* Linting — FIX: set to false to stop implicit 'any' errors on .js files */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* FIX: allows JS files to be imported without errors */
    "allowJs": true,
    "checkJs": false,

    /* FIX: import.meta.env — Vite adds this via vite/client types */
    "types": ["vite/client"]
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}